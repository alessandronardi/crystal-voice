{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Node types are needed by scripts/ and test/ only; eslint.config.js
    // forbids Node built-ins and globals inside src/.
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
