{
  "name": "voicecrystal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:golden": "node scripts/golden/seeds.ts && node scripts/golden/plates.ts",
    "test:golden:browsers": "playwright test -c playwright.golden.config.ts",
    "test:render": "playwright test -c playwright.render.config.ts",
    "fixtures": "node scripts/fixtures/generate.ts",
    "build": "pnpm --filter @voicecrystal/extension run build",
    "test:e2e": "playwright test",
    "bench": "node tests/benchmarks/run.ts",
    "bench:continuity": "node scripts/golden/continuity.ts",
    "catalog": "node scripts/golden/catalog.ts",
    "bench:robustness": "node scripts/golden/robustness.ts",
    "bench:plate-scale": "node scripts/golden/plate-scale.ts",
    "bench:render": "node tests/benchmarks/render.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@voicecrystal/calibration": "workspace:*",
    "@voicecrystal/comparator": "workspace:*",
    "@voicecrystal/contracts": "workspace:*",
    "@voicecrystal/crystal-core": "workspace:*",
    "@voicecrystal/dsp-core": "workspace:*",
    "@voicecrystal/renderer-svg": "workspace:*",
    "@voicecrystal/renderer-three": "workspace:*",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
